# ===== LogAnalyze-MCP 环境变量配置（复制为 .env 后生效）=====

# Ollama 服务地址（默认本地）
OLLAMA_BASE_URL=http://localhost:11434

# 本地大模型名称（需先在 Ollama 中 pull，例如：ollama pull qwen2.5:7b）
# 轻量选择：qwen2.5:3b / qwen2.5:1.5b（CPU 也能跑）
# 推荐选择：qwen2.5:7b（分析更准）
OLLAMA_MODEL=qwen2.5:7b

# 调用大模型的超时时间（秒）
OLLAMA_TIMEOUT=120

# 单次读取日志的最大行数（保护上下文，避免 token 爆炸）
MAX_LOG_LINES=400
